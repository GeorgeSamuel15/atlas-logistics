{
  "name": "@atlas/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "seed": "node --import tsx src/seed.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/apps/api/src/server.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "bootstrap": "node --import tsx src/bootstrap.ts",
    "fresh-start": "node --import tsx src/fresh-start.ts"
  },
  "dependencies": {
    "@atlas/shared": "1.0.0",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "express-rate-limit": "8.1.0",
    "helmet": "8.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4"
  }
}
